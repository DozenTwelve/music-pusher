# Cloudflare Pages reads this file and does not serve it.
# Every response: no sniffing, no framing, no access to devices the page never uses.
# (Pages adds Referrer-Policy and X-Content-Type-Options itself; they are repeated
# here so the policy is written down in one place.)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Built files carry a hash in their name: a changed file is a new address.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The cards and icons change rarely, under the same name.
/og/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# The project's own pages.dev address is a copy of the site: keep it out of search.
https://album-cleaner.pages.dev/*
  X-Robots-Tag: noindex
